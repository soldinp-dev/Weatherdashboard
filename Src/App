{ key: “nam”,   label: “NAM”,   color: “#ce93d8” },
];

function toF(c) { return Math.round(c * 9 / 5 + 32); }

function getTempColor(f) {
if (f === null || f === undefined) return “#555”;
if (f >= 105) return “#ff2d2d”;
if (f >= 95)  return “#ff6b35”;
if (f >= 85)  return “#ffa827”;
if (f >= 75)  return “#f5d800”;
if (f >= 65)  return “#5ddb5d”;
if (f >= 55)  return “#29c9e0”;
if (f >= 45)  return “#5599ff”;
return “#aa88ff”;
}

function getDayLabels() {
const days = [“Sun”,“Mon”,“Tue”,“Wed”,“Thu”,“Fri”,“Sat”];
const now = new Date();
return Array.from({ length: 7 }, (_, i) => {
if (i === 0) return “Today”;
if (i === 1) return “Tmrw”;
const d = new Date(now); d.setDate(now.getDate() + i);
return days[d.getDay()];
});
}

async function fetchNWS(lat, lon) {
try {
const pr = await fetch(`https://api.weather.gov/points/${lat},${lon}`);
if (!pr.ok) throw new Error(“points fail”);
const pd = await pr.json();
const fr = await fetch(pd.properties.forecast);
if (!fr.ok) throw new Error(“forecast fail”);
const fd = await fr.json();
const highs = [];
for (const p of fd.properties.periods) {
if (p.isDaytime) {
highs.push(p.temperatureUnit === “F” ? p.temperature : toF(p.temperature));
if (highs.length === 7) break;
}
}
return highs;
} catch (e) { return Array(7).fill(null); }
}

async function fetchOpenMeteo(lat, lon, modelParam) {
try {
const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&daily=temperature_2m_max&temperature_unit=fahrenheit&forecast_days=7&models=${modelParam}&timezone=auto`;
const r = await fetch(url);
if (!r.ok) throw new Error();
const d = await r.json();
return (d.daily?.temperature_2m_max || []).map(v => v !== null ? Math.round(v) : null);
} catch { return Array(7).fill(null); }
}

function ModelRow({ label, color, val, isLoading }) {
return (
<div style={{
display: “flex”, justifyContent: “space-between”, alignItems: “center”,
padding: “7px 10px”,
