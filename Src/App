export default function App() {
const [allData, setAllData] = useState({});
const [loading, setLoading] = useState(true);
const [activeDay, setActiveDay] = useState(0);
const [lastUpdated, setLastUpdated] = useState(null);
const dayLabels = getDayLabels();

const loadAll = useCallback(async () => {
setLoading(true);
const result = {};
await Promise.all(
STATIONS.map(async s => {
const [nws, ecmwf, hrrr, nam] = await Promise.all([
fetchNWS(s.lat, s.lon),
fetchOpenMeteo(s.lat, s.lon, “ecmwf_ifs025”),
fetchOpenMeteo(s.lat, s.lon, “hrrr_conus”),
fetchOpenMeteo(s.lat, s.lon, “nam_conus”),
]);
result[s.id] = { nws, ecmwf, hrrr, nam };
setAllData(prev => ({ …prev, [s.id]: result[s.id] }));
})
);
setLastUpdated(new Date().toLocaleTimeString([], { hour: “2-digit”, minute: “2-digit” }));
setLoading(false);
}, []);

useEffect(() => { loadAll(); }, [loadAll]);

return (
<div style={{ minHeight: “100vh”, background: “#08080f”, fontFamily: “‘DM Sans’, sans-serif”, paddingBottom: 40 }}>
<style>{`@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700;800&family=DM+Mono:wght@500;700&display=swap'); * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; margin: 0; padding: 0; } button { font-family: inherit; outline: none; } ::-webkit-scrollbar { display: none; }`}</style>

