</div>
<span style={{
fontFamily: “‘DM Mono’, monospace”,
fontSize: 15,
fontWeight: 700,
color: val !== null && val !== undefined ? getTempColor(val) : “#2a2a4a”
}}>
{isLoading ? “…” : val !== null && val !== undefined ? `${val}°` : “—”}
</span>
</div>
);
}

function StationCard({ station, data, dayLabels, activeDay, setActiveDay }) {
const hasData = Object.keys(data).length > 0;

const consensus = dayLabels.map((_, i) => {
const vals = MODELS.map(m => data[m.key]?.[i]).filter(v => v !== null && v !== undefined);
if (!vals.length) return null;
const avg = Math.round(vals.reduce((a, b) => a + b, 0) / vals.length);
return { avg, min: Math.min(…vals), max: Math.max(…vals), spread: Math.max(…vals) - Math.min(…vals), n: vals.length };
});

const focus = consensus[activeDay];

return (
<div style={{
background: “linear-gradient(145deg, #0e0e20, #12122a)”,
border: “1px solid #1e1e3a”,
borderRadius: 18,
padding: “15px 13px”,
marginBottom: 12,
}}>
{/* Station header */}
<div style={{ display: “flex”, justifyContent: “space-between”, alignItems: “center”, marginBottom: 11 }}>
<div>
<span style={{ color: “#c8c8ff”, fontSize: 16, fontWeight: 800, fontFamily: “‘DM Mono’, monospace” }}>{station.id}</span>
<span style={{ color: “#44446a”, fontSize: 12, marginLeft: 8 }}>{station.name}</span>
</div>
{focus && (
<div style={{ textAlign: “right” }}>
<div style={{
color: getTempColor(focus.avg),
fontSize: 24, fontWeight: 800,
fontFamily: “‘DM Mono’, monospace”, lineHeight: 1
}}>{focus.avg}°F</div>
<div style={{ color: “#33335a”, fontSize: 10, marginTop: 2 }}>
{focus.spread > 0 ? `${focus.min}–${focus.max}° range` : “consensus”}
</div>
</div>
)}
</div>

